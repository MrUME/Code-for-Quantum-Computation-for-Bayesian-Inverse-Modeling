# Title
'Water quality in the Aquia aquifer'
# '-----------------------------------------------------------------------------'
# 'DEFINITION OF THE GEOCHEMICAL SYSTEM'
# 'PRIMARY AQUEOUS SPECIES'
'h2o'      0
'h+'       0
'ca+2'     0
'mg+2'     0
'na+'      0
'k+'       0
'hco3-'    0
'so4-2'    0
'cl-'      0
'o2(aq)'   0
'xoh'      2  'calcite' 5.000E-05 3
'*'
# 'AQUEOUS KINETICS'
'*'
# 'AQUEOUS COMPLEXES'
'oh-'  
'nahco3(aq)'
'cahco3+'
'mghco3+'
'co2(aq)'
'co3-2'
'naso4-'
'kso4-'
'naco3-'
'ch4(aq)'
'*'
# 'MINERALS'         ! equilibrium mineral goes first
'calcite'           0    0     0    0
0.0   0.    0.00
'*'               
# 'GASES'   
'*'
# 'SURFACE COMPLEXES'
'xoh2+'
'xo-'
'*'
# 'species with Kd and decay    decay constant(1/s)'
'*'                    
# 'EXCHANGEABLE CATIONS'    
1     1
# '                 master     convention     ex. coef.'
'na+'               1            1            1.0000e+00
'k+'                0            1            2.0000e-01
'ca+2'              0            1            6.8909e-01
'mg+2'              0            1            6.6955e-01
'h+'                0            1            4.3159e-06
'*'                                                                                
# '----------------------------------------------------------------------------'
# 'INITIAL AND BOUDARY WATER TYPES'
1   1        !niwtype, nbwtype = number of initial and boundary waters
# Index  Speciation T(C)  P(bar)
1     25.0   1.0                         
# '        icon        guess         ctot         '
'h2o'      1        1.000e+00      1.000e+00   '   '    0.      
'h+'       3        1.995e-07      1.995e-07   '   '    0.      
'ca+2'     1        6.100e-03      6.100e-03   '   '    0.      
'mg+2'     1        1.200e-02      1.200e-02   '   '    0.      
'na+'      1        8.850e-02      8.850e-02   '   '    0.      
'k+'       1        2.160e-03      2.160e-03   '   '    0.      
'hco3-'    1        2.160e-02      2.160e-02   '   '    0.      
'so4-2'    1        2.700e-04      2.700e-04   '   '    0.      
'cl-'      1        1.018e-01      1.018e-01   '   '    0.      
'o2(aq)'   1        1.000e-05      1.000e-05   '   '    0.      
'xoh'      1        5.000e-02      5.000e-02   '   '    0.      
'*'        
# Index  Speciation T(C)  P(bar)                                                 
1     25.0   1.0                         
# '        icon        guess         ctot        '
'h2o'      1        1.000e+00      1.000e+00   '   '    0.      
'h+'       3        1.259e-07      1.259e-07   '   '    0.      
'ca+2'     1        1.542e-03      1.542e-03   '   '    0.      
'mg+2'     1        3.190e-06      3.190e-06   '   '    0.      
'na+'      1        9.640e-05      9.640e-05   '   '    0.      
'k+'       1        8.000e-05      8.000e-05   '   '    0.      
'hco3-'    1        3.057e-03      3.057e-03   '   '    0.      
'so4-2'    1        1.000e-06      1.000e-06   '   '    0.      
'cl-'      1        1.000e-04      1.000e-04   '   '    0.      
'o2(aq)'   1        1.000e-50      1.000e-50   '   '    0.      
'xoh'      1        5.000e-50      5.000e-50   '   '    0.      
'*'       
# '----------------------------------------------------------------------------'
#  'INITIAL MINERAL ZONES'
 1                                       !nmtype= number of mineral zones 
 1					!imtype
#  'mineral         vol.frac.'
 'calcite'            0.3     0
 '*'         
# '----------------------------------------------------------------------------'
# 'INITIAL gas ZONES'
'*'            
# '----------------------------------------------------------------------------'
# 'Permeability-Porosity Zones'
'*'     
# '----------------------------------------------------------------------------'
# 'INITIAL SURFACE ADSORPTION ZONES'
1   			!ndtype= number of sorption zones 
# zone       ad.surf.(cm2/g)  total ad.sites (mol/m2)
1  1    ! zone index, equilibration flag
'xoh'       0    1.00E+03
'*'                       
# '---------------------------------------if Sden=0 Kd store retardation factor'
# 'INITIAL LINEAR EQUILIBRIUM Kd ZONE
'*'
# '---------------------------------------if Sden=0 Kd store retardation factor'
# 'INITIAL ZONES OF CATION EXCHANGE'
1   			!nxtype= number of exchange zones
# 'zone            ex. capacity(meq/100 g solid)'
1                   2.3412
